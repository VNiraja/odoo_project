<odoo>
  <record id="view_giftguard_request_list" model="ir.ui.view">
    <field name="name">giftguard.request.list</field><field name="model">giftguard.request</field>
    <field name="arch" type="xml"><list><field name="name"/><field name="organisation_id"/><field name="recipient_ref"/><field name="gift_description"/><field name="amount"/><field name="currency_id"/><field name="status"/></list></field>
  </record>
  <record id="view_giftguard_request_form" model="ir.ui.view">
    <field name="name">giftguard.request.form</field><field name="model">giftguard.request</field>
    <field name="arch" type="xml"><form><header><button name="action_evaluate" type="object" string="Evaluate" class="btn-primary"/><button name="action_approve_review" type="object" string="Approve Review" groups="giftguard_compliance.group_giftguard_reviewer"/><button name="action_reject_review" type="object" string="Reject Review" groups="giftguard_compliance.group_giftguard_reviewer"/><field name="status" widget="statusbar"/></header><sheet><group><field name="name"/><field name="organisation_id"/><field name="recipient_ref"/><field name="recipient_email"/><field name="gift_description"/><field name="category"/><field name="amount"/><field name="currency_id"/><field name="deal_stage"/></group><group string="Decision"><field name="policy_id"/><field name="policy_version"/><field name="decision_reason"/><field name="evaluated_at"/><field name="reviewer_id"/><field name="reviewer_note"/></group></sheet><chatter/></form></field>
  </record>
  <record id="action_giftguard_request" model="ir.actions.act_window">
    <field name="name">Gift Requests</field><field name="res_model">giftguard.request</field><field name="view_mode">list,form</field>
  </record>
</odoo>
