<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_giftguard_request_list" model="ir.ui.view">
            <field name="name">giftguard.request.list</field>
            <field name="model">giftguard.request</field>
            <field name="arch" type="xml">
                <list string="Gift Requests">
                    <field name="name"/>
                    <field name="organisation_id"/>
                    <field name="recipient_ref"/>
                    <field name="gift_description"/>
                    <field name="amount"/>
                    <field name="currency_id"/>
                    <field name="status"/>
                    <field name="evaluated_at"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </list>
            </field>
        </record>

        <record id="view_giftguard_request_search" model="ir.ui.view">
            <field name="name">giftguard.request.search</field>
            <field name="model">giftguard.request</field>
            <field name="arch" type="xml">
                <search string="Gift Requests">
                    <field name="name"/>
                    <field name="organisation_id"/>
                    <field name="recipient_ref"/>
                    <field name="status"/>
                    <filter name="review_required" string="Needs Review"
                            domain="[('status', '=', 'review_required')]"/>
                    <filter name="approved" string="Approved"
                            domain="[('status', '=', 'approved')]"/>
                    <filter name="blocked" string="Blocked"
                            domain="[('status', '=', 'blocked')]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_organisation" string="Organisation"
                                context="{'group_by': 'organisation_id'}"/>
                        <filter name="group_status" string="Status"
                                context="{'group_by': 'status'}"/>
                        <filter name="group_company" string="Company"
                                context="{'group_by': 'company_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="view_giftguard_request_form" model="ir.ui.view">
            <field name="name">giftguard.request.form</field>
            <field name="model">giftguard.request</field>
            <field name="arch" type="xml">
                <form string="Gift Request">
                    <header>
                        <button name="action_evaluate" type="object"
                                string="Evaluate" class="btn-primary"
                                invisible="status != 'draft'"/>
                        <button name="action_approve_review" type="object"
                                string="Approve Review" class="btn-primary"
                                groups="giftguard_compliance.group_giftguard_reviewer"
                                invisible="status != 'review_required'"/>
                        <button name="action_reject_review" type="object"
                                string="Reject Review"
                                groups="giftguard_compliance.group_giftguard_reviewer"
                                invisible="status != 'review_required'"/>
                        <field name="status" widget="statusbar" readonly="1"/>
                    </header>
                    <sheet>
                        <group>
                            <group string="Request">
                                <field name="name"/>
                                <field name="organisation_id"
                                       readonly="status != 'draft'"/>
                                <field name="recipient_ref"
                                       readonly="status != 'draft'"/>
                                <field name="recipient_email"
                                       readonly="status != 'draft'"/>
                                <field name="gift_description"
                                       readonly="status != 'draft'"/>
                                <field name="category" readonly="status != 'draft'"/>
                            </group>
                            <group string="Gift Details">
                                <field name="amount" readonly="status != 'draft'"/>
                                <field name="currency_id"
                                       readonly="status != 'draft'"/>
                                <field name="deal_stage"
                                       readonly="status != 'draft'"/>
                                <field name="company_id"
                                       groups="base.group_multi_company"
                                       readonly="1"/>
                            </group>
                        </group>
                        <group string="Decision">
                            <field name="policy_id"/>
                            <field name="policy_version"/>
                            <field name="decision_reason"/>
                            <field name="evaluated_at"/>
                            <field name="reviewer_id"/>
                            <field name="reviewer_note"
                                   readonly="status not in ('draft', 'review_required')"
                                   required="status == 'review_required'"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_giftguard_request" model="ir.actions.act_window">
            <field name="name">Gift Requests</field>
            <field name="res_model">giftguard.request</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_giftguard_request_search"/>
        </record>

    </data>
</odoo>
