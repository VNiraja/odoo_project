<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_giftguard_policy_list" model="ir.ui.view">
            <field name="name">giftguard.policy.list</field>
            <field name="model">giftguard.policy</field>
            <field name="arch" type="xml">
                <list string="Policies">
                    <field name="name"/>
                    <field name="organisation_id"/>
                    <field name="state"/>
                    <field name="effective_date"/>
                    <field name="review_date"/>
                    <field name="version"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </list>
            </field>
        </record>

        <record id="view_giftguard_policy_search" model="ir.ui.view">
            <field name="name">giftguard.policy.search</field>
            <field name="model">giftguard.policy</field>
            <field name="arch" type="xml">
                <search string="Policies">
                    <field name="name"/>
                    <field name="organisation_id"/>
                    <field name="state"/>
                    <filter name="draft" string="Draft"
                            domain="[('state', '=', 'draft')]"/>
                    <filter name="verified" string="Verified"
                            domain="[('state', '=', 'verified')]"/>
                    <filter name="expired" string="Expired"
                            domain="[('state', '=', 'expired')]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_organisation" string="Organisation"
                                context="{'group_by': 'organisation_id'}"/>
                        <filter name="group_state" string="Status"
                                context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="view_giftguard_policy_form" model="ir.ui.view">
            <field name="name">giftguard.policy.form</field>
            <field name="model">giftguard.policy</field>
            <field name="arch" type="xml">
                <form string="Gifting Policy">
                    <header>
                        <button name="action_verify" type="object"
                                string="Mark Verified" class="btn-primary"
                                groups="giftguard_compliance.group_giftguard_manager"
                                invisible="state != 'draft'"/>
                        <button name="action_expire" type="object"
                                string="Expire"
                                groups="giftguard_compliance.group_giftguard_manager"
                                invisible="state != 'verified'"/>
                        <field name="state" widget="statusbar" readonly="1"/>
                    </header>
                    <sheet>
                        <group>
                            <field name="name" readonly="state != 'draft'"/>
                            <field name="organisation_id" readonly="state != 'draft'"/>
                            <field name="source_reference" readonly="state != 'draft'"/>
                            <field name="owner_name" readonly="state != 'draft'"/>
                            <field name="effective_date" readonly="state != 'draft'"/>
                            <field name="review_date" readonly="state != 'draft'"/>
                            <field name="version" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"
                                   readonly="1"/>
                        </group>
                        <notebook>
                            <page string="Rules" name="rules">
                                <field name="rule_ids" readonly="state != 'draft'">
                                    <list editable="bottom">
                                        <field name="sequence"/>
                                        <field name="active"/>
                                        <field name="rule_type"/>
                                        <field name="currency_id"/>
                                        <field name="amount"/>
                                        <field name="category"/>
                                        <field name="deal_stage"/>
                                        <field name="max_sends"/>
                                        <field name="period_days"/>
                                        <field name="description"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_giftguard_policy" model="ir.actions.act_window">
            <field name="name">Policies</field>
            <field name="res_model">giftguard.policy</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_giftguard_policy_search"/>
        </record>

    </data>
</odoo>
